#!/usr/bin/env bash
set -euo pipefail

DEBUG=false
if [[ "${1:-}" == "--debug" ]]; then
  DEBUG=true
  shift
fi

debug() {
  if $DEBUG; then
    echo "[debug] $*" >&2
  fi
}

CONFIG_FILE=".envtree.json"

# Find repo root from current directory
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Error: not inside a git repository."
  exit 1
}

usage() {
  echo "Usage: envtree [--debug] <init|pull|push>"
  echo ""
  echo "  init          Create a $CONFIG_FILE config file for this repo"
  echo "  pull [<dir>]  Copy .env files from source into this worktree"
  echo "  push [<dir>]  Copy .env files from this worktree into target"
  echo ""
  echo "  --debug       Show detailed resolution and copy steps"
  echo ""
  echo "Source priority: <dir> arg > \$ENVTREE_SOURCE > \"source\" in $CONFIG_FILE"
  echo ""
  echo "\$ENVTREE_SOURCE lets each machine set its own source directory without"
  echo "committing a personal path. Paths may use ~ and \$VAR / \${VAR}."
  exit 1
}

# Expand a leading ~ and any $VAR / ${VAR} references in a path.
# Done manually rather than with eval so config values can't execute code.
expand_path() {
  local raw="$1"
  local rest="${raw/#\~/$HOME}"
  local result=""
  local re='^([^$]*)\$(\{([A-Za-z_][A-Za-z0-9_]*)\}|([A-Za-z_][A-Za-z0-9_]*))(.*)$'

  while [[ "$rest" =~ $re ]]; do
    local name="${BASH_REMATCH[3]:-${BASH_REMATCH[4]}}"
    if [[ ! -v "$name" ]]; then
      echo "Error: environment variable \$$name (used in '$raw') is not set." >&2
      exit 1
    fi
    result+="${BASH_REMATCH[1]}${!name}"
    rest="${BASH_REMATCH[5]}"
  done

  printf '%s' "$result$rest"
}

# Read a top-level key from the config with node rather than by matching lines,
# so reformatting $CONFIG_FILE (Prettier, Biome, minifying, tabs) can't break it.
# Strings print as one line, arrays one string element per line, missing keys
# nothing. Callers must check the exit status: $( ) subshells don't inherit
# errexit without bash 4.4's inherit_errexit, and macOS ships bash 3.2.
read_config_key() {
  local key="$1"
  local config="${REPO_ROOT}/${CONFIG_FILE}"

  command -v node > /dev/null 2>&1 || {
    echo "Error: envtree needs node to read $CONFIG_FILE." >&2
    exit 1
  }

  node -e '
const [file, key] = process.argv.slice(1);
let cfg;
try {
  cfg = JSON.parse(require("fs").readFileSync(file, "utf8"));
} catch (e) {
  console.error("Error: " + file + " is not valid JSON: " + e.message);
  process.exit(1);
}
for (const v of [].concat((cfg || {})[key] ?? [])) {
  if (typeof v === "string") console.log(v);
}
' "$config" "$key"
}

# Resolve env files from config globs
resolve_files() {
  local root="$1"
  local config="${REPO_ROOT}/${CONFIG_FILE}"

  if [ ! -f "$config" ]; then
    echo "Error: $CONFIG_FILE not found in repo root."
    echo "Run 'envtree init' to create one."
    exit 1
  fi

  local globs
  globs="$(read_config_key files)" || exit 1
  if [ -z "$globs" ]; then
    echo "Error: \"files\" is required in $CONFIG_FILE." >&2
    echo "Set it to a list of glob patterns (e.g. [\".env\", \"apps/*/.env.local\"])." >&2
    exit 1
  fi
  debug "config globs: $(echo "$globs" | tr '\n' ', ')"

  local files=()
  while IFS= read -r glob; do
    debug "resolving glob '$glob' in $root"
    if [[ "$glob" != *'**'* ]]; then
      # No recursive wildcard — use fast bash globbing
      local matches
      matches=( $(cd "$root" && compgen -G "./$glob" 2>/dev/null) ) || true
      for match in "${matches[@]}"; do
        files+=("${match#./}")
      done
    else
      # Recursive glob — use find with -prune for speed
      while IFS= read -r -d '' match; do
        files+=("${match#./}")
      done < <(cd "$root" && find . \
        \( -name node_modules -o -name .git -o -name .next -o -name dist -o -name .cache -o -name vendor \) -prune \
        -o -path "./$glob" -print0 2>/dev/null)
    fi
  done <<< "$globs"

  debug "resolved ${#files[@]} file(s): ${files[*]}"
  printf '%s\n' "${files[@]}"
}

# Resolve the source directory: $ENVTREE_SOURCE wins over "source" in the config.
get_default_source() {
  local raw origin
  if [ -n "${ENVTREE_SOURCE:-}" ]; then
    raw="$ENVTREE_SOURCE"
    origin="\$ENVTREE_SOURCE"
  else
    local config="${REPO_ROOT}/${CONFIG_FILE}"
    if [ ! -f "$config" ]; then
      echo "Error: $CONFIG_FILE not found in repo root." >&2
      echo "Run 'envtree init' to create one, or set \$ENVTREE_SOURCE." >&2
      exit 1
    fi

    raw="$(read_config_key source)" || exit 1
    raw="${raw%%$'\n'*}"
    origin="\"source\" in $CONFIG_FILE"
    if [ -z "$raw" ]; then
      echo "Error: no source directory configured." >&2
      echo "Set \$ENVTREE_SOURCE to the directory containing your .env files," >&2
      echo "or add \"source\" to $CONFIG_FILE (e.g. ~/projects/myapp)." >&2
      exit 1
    fi
  fi

  local expanded
  expanded="$(expand_path "$raw")" || exit 1
  debug "source from $origin: '$raw' -> '$expanded'"
  if [ -d "$expanded" ]; then
    echo "$expanded"
  else
    echo "Error: source directory '$raw' (from $origin) not found." >&2
    exit 1
  fi
}

cmd_init() {
  local config="${REPO_ROOT}/${CONFIG_FILE}"

  if [ -f "$config" ]; then
    echo "$CONFIG_FILE already exists:"
    cat "$config"
    echo ""
    printf "Overwrite? [y/N] "
    read -r answer
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
      echo "Aborted."
      exit 0
    fi
  fi

  echo "Source directory (where your .env files live):"
  echo "Examples: ~/projects/myapp, \$PROJECTS/myapp"
  echo ""
  echo "Leave empty to omit it, and set \$ENVTREE_SOURCE per machine instead."
  echo "$CONFIG_FILE is committed, so a literal path has to be valid for everyone."
  echo ""
  printf "> "
  read -r source_dir

  echo ""
  echo "Enter .env file glob patterns (one per line, empty line to finish):"
  echo "Examples: apps/api/.env.local, **/.env, apps/*/.env.local"
  echo ""

  local globs=()
  while true; do
    printf "> "
    read -r glob
    [ -z "$glob" ] && break
    globs+=("$glob")
  done

  if [ ${#globs[@]} -eq 0 ]; then
    echo "No patterns entered. Aborted."
    exit 1
  fi

  # Serialize with node so values needing escaping (" or \) stay valid JSON.
  # An empty source is omitted, leaving $ENVTREE_SOURCE to supply it.
  node -e '
const fs = require("fs");
const [file, source, ...files] = process.argv.slice(1);
const cfg = source ? { source: source, files: files } : { files: files };
fs.writeFileSync(file, JSON.stringify(cfg, null, 2) + "\n");
' "$config" "$source_dir" "${globs[@]}"

  echo ""
  echo "Created $CONFIG_FILE:"
  cat "$config"

  if [ -z "$source_dir" ]; then
    echo ""
    echo "No source in $CONFIG_FILE — set \$ENVTREE_SOURCE before running pull/push:"
    echo ""
    echo "  bash/zsh:  echo 'export ENVTREE_SOURCE=\"\$HOME/projects/myapp\"' >> ~/.zshrc"
    echo "  fish:      set -Ux ENVTREE_SOURCE \"\$HOME/projects/myapp\""
  fi
}

cmd_pull() {
  local source label
  if [ -n "${1:-}" ]; then
    source="$(cd "$1" && pwd)" || { echo "Error: directory '$1' not found." >&2; exit 1; }
    label="$source"
  else
    source="$(get_default_source)"
    label="$source"
  fi

  debug "pull source: '$source' ($label)"

  local files
  files="$(resolve_files "$source")"

  if [ -z "$files" ]; then
    echo "No .env files matched in $label."
    exit 1
  fi

  local count=0
  while IFS= read -r rel; do
    src="${source}/${rel}"
    dest="${REPO_ROOT}/${rel}"
    mkdir -p "$(dirname "$dest")"
    debug "cp $src -> $dest"
    cp "$src" "$dest"
    echo "  pulled: $rel"
    count=$((count + 1))
  done <<< "$files"

  echo "Pulled $count env file(s) from $label"
}

cmd_push() {
  local target label
  if [ -n "${1:-}" ]; then
    target="$(cd "$1" && pwd)" || { echo "Error: directory '$1' not found." >&2; exit 1; }
    label="$target"
  else
    target="$(get_default_source)"
    label="$target"
  fi

  debug "push target: '$target' ($label)"

  local files
  files="$(resolve_files "$REPO_ROOT")"

  if [ -z "$files" ]; then
    echo "No .env files matched in this worktree."
    exit 1
  fi

  echo "Push to $label ($target):"
  local found=()
  while IFS= read -r rel; do
    echo "  $rel"
    found+=("$rel")
  done <<< "$files"
  echo ""

  local has_diff=false
  for rel in "${found[@]}"; do
    dest="${target}/${rel}"
    if [ -f "$dest" ] && ! diff -q "${REPO_ROOT}/${rel}" "$dest" > /dev/null 2>&1; then
      has_diff=true
      break
    fi
  done

  if [ "$has_diff" = true ]; then
    echo "Warning: this will overwrite files in $label."
    printf "Continue? [y/N] "
    read -r answer
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
      echo "Aborted."
      exit 0
    fi
  fi

  local count=0
  for rel in "${found[@]}"; do
    src="${REPO_ROOT}/${rel}"
    dest="${target}/${rel}"
    mkdir -p "$(dirname "$dest")"
    debug "cp $src -> $dest"
    cp "$src" "$dest"
    echo "  pushed: $rel"
    count=$((count + 1))
  done

  echo "Pushed $count env file(s) to $label"
}

case "${1:-}" in
  init) cmd_init ;;
  pull) cmd_pull "${2:-}" ;;
  push) cmd_push "${2:-}" ;;
  *) usage ;;
esac
